    "f0_hz": 18.0
  },
  "repliques": [
    {
      "id": "troupe_00",
      "role": "Meneur",
      "texte": "Recompte. Et cette fois compte-la elle, pas ce que tu voudrais qu'elle vaille."
    },
    {
      "id": "troupe_01",
      "role": "Garde",
      "texte": "Nous avons vu que la porte royale avait servi, Altesse. Le roi et la reine sont —"
    },
    {
      "id": "troupe_02",
      "role": "Crieur",
      "texte": "Mesdames, messieurs ! Que l'on veuille bien se tourner vers la loge du haut : le roi et la reine de Sapin nous font l'honneur d'être des nôtres !"
    },
    {
      "id": "troupe_03",
      "role": "Examinatrice",
      "texte": "Diane Whitehall, dix-huit ans, conjureuse au stade orange plein, spécialisation unique en eau. Commençons."
    },
    {
      "id": "troupe_04",
      "role": "Réceptionniste",
      "texte": "Une classe S. Dans un donjon classé AA. Ce n'est pas une erreur de cotation, ça — c'est autre chose, et il faudra que la guilde comprenne quoi."
    },
    {
      "id": "troupe_05",
      "role": "Juge",
      "texte": "Il lui est en outre interdit de se réinscrire comme aventurier jusqu'à nouvel ordre de la guilde. Vous rendrez votre carte."
    }
  ],
