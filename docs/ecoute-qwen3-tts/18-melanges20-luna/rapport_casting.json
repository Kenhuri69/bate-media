  "repliques": [
    {
      "id": "luna_elven_dormitory_01_01",
      "chapitre": "elven_dormitory_01",
      "texte": "Il ne saignait plus au bout d'un quart d'heure. Je veux que vous le sachiez parce que tout le monde va dire que je n'ai rien pu faire. Il ne saignait plus. Il parlait. Il m'a demandé si les premières années étaient descendues."
    },
    {
      "id": "luna_elven_dormitory_01_04",
      "chapitre": "elven_dormitory_01",
      "texte": "Un. Il n'y en a eu qu'un. Je ne me suis pas vidée sur trois personnes, j'ai fait exactement ce que vous m'avez dit — et ça n'a servi à rien du tout, alors ne me demandez pas de trouver ça bien."
    },
    {
      "id": "luna_elven_dormitory_03_01",
      "chapitre": "elven_dormitory_03",
      "texte": "J'ai su à la quatrième heure. Il avait les mains froides et je n'arrivais plus à les réchauffer, et ce n'était pas la pièce."
    },
    {
      "id": "luna_elven_dormitory_03_03",
      "chapitre": "elven_dormitory_03",
      "texte": "Il m'a demandé deux fois si les petites étaient descendues. La deuxième fois il ne savait plus qu'il l'avait déjà demandé, et j'ai répondu pareil, et j'ai été contente de pouvoir répondre pareil."
    },
    {
      "id": "luna_elven_dormitory_03_06",
      "chapitre": "elven_dormitory_03",
      "texte": "Je ne sais pas. Je comprimais."
    },
    {
      "id": "luna_loriande_awakening_01_01",
      "chapitre": "loriande_awakening_01",
      "texte": "Il s'est couché tout seul. Je le tenais pour qu'il ne se relève pas."
    },
    {
      "id": "luna_loriande_awakening_02_01",
      "chapitre": "loriande_awakening_02",
      "texte": "...Moi j'en vois. J'en vois depuis longtemps. Personne ne m'a jamais dit que ça avait un nom."
    },
    {
      "id": "luna_loriande_awakening_02_02",
      "chapitre": "loriande_awakening_02",
      "texte": "Elles sont partout. Elles sont partout, il y en a des milliers, elles n'étaient pas comme ça avant."
    },
    {
      "id": "luna_loriande_awakening_02_03",
      "chapitre": "loriande_awakening_02",
      "texte": "Non. Non, ne coupez pas — j'ai compris, j'ai compris ce que c'est, laissez-moi finir."
    },
    {
      "id": "luna_loriande_awakening_02_04",
      "chapitre": "loriande_awakening_02",
      "texte": "Encore un peu. Ça ne fatigue pas. Ça ne fatigue pas du tout, c'est ça que je n'arrive pas à vous faire comprendre."
    },
    {
      "id": "luna_loriande_awakening_02_05",
      "chapitre": "loriande_awakening_02",
      "texte": "...D'accord."
    },
    {
      "id": "luna_loriande_awakening_03_01",
      "chapitre": "loriande_awakening_03",
      "texte": "Et si la troisième est Lise ?"
    },
    {
      "id": "luna_loriande_awakening_03_02",
      "chapitre": "loriande_awakening_03",
      "texte": "C'est ce que vous faisiez, avant ? Dans... avant."
    },
    {
      "id": "luna_xyrus_first_frost_01_01",
      "chapitre": "xyrus_first_frost_01",
      "texte": "Bonjour."
    },
    {
      "id": "luna_xyrus_first_frost_01_02",
      "chapitre": "xyrus_first_frost_01",
      "texte": "...Oui. Arrivées le mois dernier."
    },
    {
      "id": "luna_xyrus_first_frost_01_03",
      "chapitre": "xyrus_first_frost_01",
      "texte": "Il a recensé quarante et un enfants. Il a mis une marque à côté de mon nom. Je ne sais pas laquelle et personne n'a voulu me la lire."
    },
    {
      "id": "luna_xyrus_first_frost_01_04",
      "chapitre": "xyrus_first_frost_01",
      "texte": "Pourquoi ?"
    },
    {
      "id": "luna_xyrus_first_frost_02_01",
      "chapitre": "xyrus_first_frost_02",
      "texte": "Tu as l'épaule droite qui chauffe depuis avant-hier. Toi, le mollet. Tessia, tu tires huit séries alors que ton dos t'en autorise cinq, et tu le sais."
    },
    {
      "id": "luna_xyrus_first_frost_02_02",
      "chapitre": "xyrus_first_frost_02",
      "texte": "Je ne sais pas. C'est comme une pièce où il y a une bougie allumée quelque part : on ne voit pas la bougie, on voit que la pièce n'est pas noire. Chez vous il y a des endroits pas noirs."
    },
    {
      "id": "luna_xyrus_first_frost_03_01",
      "chapitre": "xyrus_first_frost_03",
      "texte": "Je le tiens. Faites venir un brancard, ne le déplacez pas sans moi, et dites-moi quand vous êtes prêts. Je ne peux pas lâcher avant."
    }
  ],
